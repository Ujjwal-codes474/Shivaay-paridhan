{
  "redirects": [
    { "source": "/index.html", "destination": "/", "permanent": true },
    { "source": "/shop.html", "destination": "/shop", "permanent": true },
    { "source": "/products.html", "destination": "/products", "permanent": true },
    { "source": "/about.html", "destination": "/about", "permanent": true },
    { "source": "/contact.html", "destination": "/contact", "permanent": true },
    { "source": "/cart.html", "destination": "/cart", "permanent": true },
    { "source": "/login.html", "destination": "/login", "permanent": true },
    { "source": "/clothing.html", "destination": "/clothing", "permanent": true },
    { "source": "/jwellery.html", "destination": "/jwellery", "permanent": true }
  ],
  "rewrites": [
    { "source": "/shop", "destination": "/shop.html" },
    { "source": "/products", "destination": "/products.html" },
    { "source": "/product/:slug", "destination": "/product.html" },
    { "source": "/about", "destination": "/about.html" },
    { "source": "/contact", "destination": "/contact.html" },
    { "source": "/cart", "destination": "/cart.html" },
    { "source": "/login", "destination": "/login.html" },
    { "source": "/clothing", "destination": "/clothing.html" },
    { "source": "/jwellery", "destination": "/jwellery.html" },
    { "source": "/profile", "destination": "/profile.html" },
    { "source": "/admin", "destination": "/admin.html" },
    { "source": "/checkout", "destination": "/checkout.html" },
    { "source": "/success", "destination": "/success.html" }
  ]
}
