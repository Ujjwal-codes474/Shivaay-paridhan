{
  "rewrites": [
    {
      "source": "/shop",
      "destination": "/shop.html"
    },
    {
      "source": "/products",
      "destination": "/products.html"
    },
    {
      "source": "/product/:slug",
      "destination": "/product.html"
    },
    {
      "source": "/about",
      "destination": "/about.html"
    },
    {
      "source": "/contact",
      "destination": "/contact.html"
    },
    {
      "source": "/cart",
      "destination": "/cart.html"
    },
    {
      "source": "/login",
      "destination": "/login.html"
    }
  ]
}
